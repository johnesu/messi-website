# ---- Runtime / Secrets ----
# Never commit real secrets to version control. Copy to .env and fill in real values.

# App
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql://mesi:mesi@localhost:5432/mesi?schema=public

# Redis / Queue
REDIS_URL=redis://localhost:6379

# Auth (generate strong random strings, e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_16_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payments (use sandbox/test keys in development)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_TEST_MODE=true

# Storage (S3-compatible, e.g. MinIO endpoint in dev)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=mesi
STORAGE_PUBLIC_URL=http://localhost:9000/mesi

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@mesi.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Store
STORE_CURRENCY=NGN
STORE_NAME=MESI Marketplace
